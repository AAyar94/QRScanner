<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the QR history database from cloud backup -->
        <exclude domain="database" path="qr_history_database" />
        <exclude domain="database" path="qr_history_database-shm" />
        <exclude domain="database" path="qr_history_database-wal" />
        <!-- Exclude DataStore preferences from cloud backup -->
        <exclude domain="file" path="datastore/QRDataStore.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="qr_history_database" />
        <exclude domain="database" path="qr_history_database-shm" />
        <exclude domain="database" path="qr_history_database-wal" />
        <exclude domain="file" path="datastore/QRDataStore.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
